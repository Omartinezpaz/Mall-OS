{
  "cli": {
    "appVersionSource": "remote"
  },
  "expo": {
    "name": "Mall OS",
    "slug": "osmall",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "mallos",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mallos.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "package": "com.mallos.app"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "15776f99-b12a-45bb-85cd-5fca8a4a5c4a"
      }
    },
    "owner": "osmalls-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/15776f99-b12a-45bb-85cd-5fca8a4a5c4a"
    }
  }
}