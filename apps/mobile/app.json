{
  "expo": {
    "name": "Mall OS",
    "slug": "osmall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "mallos",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A369D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mallos.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A369D"
      },
      "package": "com.mallos.app"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "15776f99-b12a-45bb-85cd-5fca8a4a5c4a"
      }
    },
    "owner": "osmalls-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/15776f99-b12a-45bb-85cd-5fca8a4a5c4a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000
    }
  }
}