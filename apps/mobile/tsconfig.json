{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./app/*"],
      "@mallos/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@mallos/design-tokens/*": ["../../packages/design-tokens/src/*"],
      "@mallos/map-engine": ["../../packages/map-engine/src/index.ts"],
      "@mallos/map-engine/*": ["../../packages/map-engine/src/*"],
      "@mallos/types": ["../../packages/types/src/index.ts"],
      "@mallos/types/*": ["../../packages/types/src/*"],
      "@mallos/validators": ["../../packages/validators/src/index.ts"],
      "@mallos/validators/*": ["../../packages/validators/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/*/src/**/*.ts",
    "../../packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "../../packages/**/*.test.ts",
    "../../packages/**/*.test.tsx"
  ]
}
